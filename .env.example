# Server
PORT=3000

# Smokeball OAuth2 + API (AU Staging)
SMOKEBALL_CLIENT_ID=your_client_id
SMOKEBALL_CLIENT_SECRET=your_client_secret
SMOKEBALL_API_KEY=your_api_key
SMOKEBALL_AUTH_URL=https://datastaging-auth.smokeball.com.au
SMOKEBALL_API_URL=https://stagingapi.smokeball.com.au
# Web app origin only (no /contacts path) — used when building contactUrl in API responses
SMOKEBALL_APP_URL=https://app.smokeball.com.au

# OAuth redirect handling:
# proxy (default) - middleware sends SMOKEBALL_REDIRECT_URI to Smokeball, receives the code,
#   then forwards it back to the 3CX PBX. Register SMOKEBALL_REDIRECT_URI in Smokeball.
# passthrough - 3CX redirect_uri is sent to Smokeball unchanged.
#   Use only if Smokeball registers your 3CX callback, e.g. https://your-pbx.3cx.com.au/api/oauth2crm
SMOKEBALL_OAUTH_MODE=proxy
SMOKEBALL_REDIRECT_URI=https://your-middleware.azurewebsites.net/auth/callback
PUBLIC_URL=https://your-middleware.azurewebsites.net

# API resilience (optional)
SMOKEBALL_MAX_RETRIES=3
SMOKEBALL_RETRY_BASE_DELAY_MS=500
SMOKEBALL_SEARCH_LIMIT=50

# Call / chat journaling → Smokeball tasks + optional time entries
# Master switch (also requires Enable Call/Chat Journaling in 3CX CRM settings)
JOURNAL_CREATE_TASKS=true
# Skip journaling when no Smokeball contact matched (recommended for reception / telemarketer filtering)
JOURNAL_REQUIRE_CONTACT=true
# Skip journaling when contact has no open/pending matter
JOURNAL_REQUIRE_MATTER=false
# Auto time-cost the call duration onto the related matter (feeType=Time)
JOURNAL_CREATE_TIME_ENTRIES=true
# Skip missed / unanswered call types
JOURNAL_SKIP_MISSED=false
# Fallback Smokeball staff GUID when agent email/name lookup fails (required for reliable task creation)
SMOKEBALL_DEFAULT_STAFF_ID=
# Optional Smokeball activity code for time entries (e.g. TEL)
SMOKEBALL_TIME_ACTIVITY_CODE=
