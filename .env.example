# Server
PORT=3000

# Smokeball OAuth2 + API (AU Staging)
SMOKEBALL_CLIENT_ID=your_client_id
SMOKEBALL_CLIENT_SECRET=your_client_secret
SMOKEBALL_API_KEY=your_api_key
SMOKEBALL_AUTH_URL=https://datastaging-auth.smokeball.com.au
SMOKEBALL_API_URL=https://stagingapi.smokeball.com.au

# OAuth redirect handling:
# proxy (default) - middleware sends SMOKEBALL_REDIRECT_URI to Smokeball, receives the code,
#   then forwards it back to the 3CX PBX. Register SMOKEBALL_REDIRECT_URI in Smokeball.
# passthrough - 3CX redirect_uri is sent to Smokeball unchanged.
#   Use only if Smokeball registers your 3CX callback, e.g. https://your-pbx.3cx.com.au/api/oauth2crm
SMOKEBALL_OAUTH_MODE=proxy
SMOKEBALL_REDIRECT_URI=https://your-middleware.vercel.app/auth/callback
PUBLIC_URL=https://your-middleware.vercel.app
