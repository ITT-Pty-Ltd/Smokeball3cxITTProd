<?xml version="1.0" encoding="utf-8"?>
<Crm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" Country="AU" Name="Smokeball ITT" Version="2" SupportsEmojis="true" SupportsTranscription="true" ListPageSize="0">
  <Number Prefix="AsIs" MaxLength="" />
  <Connection MaxConcurrentRequests="2" />
  <Parameters>
    <Parameter Name="LookupOrder" Type="List" Parent="General Configuration" Editor="String" Title="Contact Lookup Order:" Validation="" Default="Contacts" ListValues="Contacts" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="MiddlewareServerUrl" Type="String" Parent="General Configuration" Editor="String" Title="Middleware Server URL:" Validation="" Default="https://smokeball3cx-itt.vercel.app" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="ApiKey" Type="String" Parent="General Configuration" Editor="String" Title="API Key:" Validation="" Default="" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="ClientId" Type="String" Parent="General Configuration" Editor="String" Title="Client ID:" Validation="" Default="5idpvktscv7ttns3ps76dsn01k" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="ClientSecret" Type="Password" Parent="General Configuration" Editor="String" Title="Client Secret:" Validation="" Default="" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="RefreshToken" Type="OAuth" Parent="General Configuration" Editor="String" Title="Refresh Token:" Validation="" Default="" ListValues="" RequestUrl="[MiddlewareServerUrl]/api/3cx/oauth2/authorize" RequestUrlParameters="response_type=code&amp;client_id=[ClientId]&amp;redirect_uri=[RedirectUri]&amp;state=[State]&amp;code_challenge=[CodeChallenge]" ResponseScenario="OAuthGetAccessToken" />
    <Parameter Name="ReportCallEnabled" Type="Boolean" Parent="" Editor="String" Title="Enable Call Journaling" Validation="" Default="False" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="Subject" Type="String" Parent="ReportCallEnabled" Editor="String" Title="Call Subject:" Validation="" Default="3CX PhoneSystem Call" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="InboundCallText" Type="String" Parent="ReportCallEnabled" Editor="String" Title="Answered Inbound Call:" Validation="" Default="[DateTime]: Answered incoming call from [Number] [Name] to [Agent] ([Duration])" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="MissedCallText" Type="String" Parent="ReportCallEnabled" Editor="String" Title="Missed Call:" Validation="" Default="[DateTime]: Missed call from [Number] [Name] to [Agent]" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="OutboundCallText" Type="String" Parent="ReportCallEnabled" Editor="String" Title="Answered Outbound Call:" Validation="" Default="[DateTime]: Answered outgoing call from [Agent] to [Number] [Name] ([Duration])" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="NotAnsweredOutboundCallText" Type="String" Parent="ReportCallEnabled" Editor="String" Title="Unanswered Outbound Call:" Validation="" Default="[DateTime]: Unanswered outgoing call from [Agent] to [Number] [Name]" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
  </Parameters>
  <Authentication Type="Scenario">
    <Value>Auth</Value>
  </Authentication>
  <Scenarios>
    <Scenario Id="Auth" Type="REST" EntityId="" EntityOrder="">
      <Request SkipIf="" Url="[MiddlewareServerUrl]/api/3cx/oauth2/token" MessagePasses="0" Message="" RequestContentType="" RequestEncoding="UrlEncoded" RequestType="Post" ResponseType="Json">
        <PostValues Key="" If="" SkipIf="">
          <Value Key="grant_type" If="" SkipIf="" Passes="0" Type="String">refresh_token</Value>
          <Value Key="refresh_token" If="" SkipIf="" Passes="0" Type="String">[RefreshToken]</Value>
          <Value Key="client_id" If="" SkipIf="" Passes="0" Type="String">[ClientId]</Value>
          <Value Key="client_secret" If="" SkipIf="" Passes="0" Type="String">[ClientSecret]</Value>
        </PostValues>
      </Request>
      <Rules>
        <Rule Type="Any" Ethalon="">access_token</Rule>
      </Rules>
      <Variables>
        <Variable Name="AccessToken" LookupValue="" Path="">access_token<Filter /></Variable>
      </Variables>
      <Outputs AllowEmpty="false">
        <Output Type="Bearer" Passes="0" Value="[AccessToken]" />
      </Outputs>
    </Scenario>

    <Scenario Id="OAuthGetAccessToken" Type="REST" EntityId="" EntityOrder="">
      <Request SkipIf="" Url="[MiddlewareServerUrl]/api/3cx/oauth2/token" MessagePasses="0" Message="" RequestContentType="" RequestEncoding="UrlEncoded" RequestType="Post" ResponseType="Json">
        <PostValues Key="" If="" SkipIf="">
          <Value Key="code" If="" SkipIf="" Passes="0" Type="String">[code]</Value>
          <Value Key="grant_type" If="" SkipIf="" Passes="0" Type="String">authorization_code</Value>
          <Value Key="client_id" If="" SkipIf="" Passes="0" Type="String">[ClientId]</Value>
          <Value Key="client_secret" If="" SkipIf="" Passes="0" Type="String">[ClientSecret]</Value>
          <Value Key="redirect_uri" If="" SkipIf="" Passes="0" Type="String">[RedirectUri]</Value>
          <Value Key="code_verifier" If="" SkipIf="" Passes="0" Type="String">[CodeVerifier]</Value>
          <Value Key="state" If="" SkipIf="" Passes="0" Type="String">[state]</Value>
        </PostValues>
      </Request>
      <Rules>
        <Rule Type="Any" Ethalon="">refresh_token</Rule>
      </Rules>
      <Variables>
        <Variable Name="Result" LookupValue="" Path="">refresh_token<Filter /></Variable>
      </Variables>
      <Outputs AllowEmpty="false">
        <Output Type="Result" Passes="0" Value="[Result]" />
      </Outputs>
    </Scenario>

    <Scenario Id="" Type="REST" EntityId="Contacts" EntityOrder="[LookupOrder]">
      <Request SkipIf="" Url="[MiddlewareServerUrl]/api/3cx/lookup?number=[Number]" MessagePasses="0" Message="" RequestContentType="" RequestEncoding="UrlEncoded" RequestType="Get" ResponseType="Json" />
      <Rules>
        <Rule Type="Any" Ethalon="">contacts.id</Rule>
      </Rules>
      <Variables>
        <Variable Name="Id" LookupValue="" Path="contacts.id"><Filter /></Variable>
        <Variable Name="FirstName" LookupValue="" Path="contacts.firstName"><Filter /></Variable>
        <Variable Name="LastName" LookupValue="" Path="contacts.lastName"><Filter /></Variable>
        <Variable Name="CompanyName" LookupValue="" Path="contacts.company"><Filter /></Variable>
        <Variable Name="PhoneMobile" LookupValue="" Path="contacts.phone"><Filter /></Variable>
        <Variable Name="Email" LookupValue="" Path="contacts.email"><Filter /></Variable>
        <Variable Name="ContactUrl" LookupValue="" Path="contacts.contactUrl"><Filter /></Variable>
      </Variables>
      <Outputs AllowEmpty="true">
        <Output Type="ContactUrl" Passes="0" Value="[ContactUrl]" />
        <Output Type="FirstName" Passes="0" Value="[FirstName]" />
        <Output Type="LastName" Passes="0" Value="[LastName]" />
        <Output Type="CompanyName" Passes="0" Value="[CompanyName]" />
        <Output Type="PhoneMobile" Passes="0" Value="[PhoneMobile]" />
        <Output Type="Email" Passes="0" Value="[Email]" />
        <Output Type="EntityType" Passes="0" Value="Contacts" />
        <Output Type="EntityId" Passes="0" Value="[Id]" />
      </Outputs>
    </Scenario>

    <Scenario Id="ReportCall" Type="REST" EntityId="" EntityOrder="">
      <Request SkipIf="[ReportCallEnabled]!=True||[EntityId]==&quot;&quot;" Url="[MiddlewareServerUrl]/api/3cx/journal" MessagePasses="0" Message="" RequestContentType="" RequestEncoding="Json" RequestType="Post" ResponseType="Json">
        <PostValues Key="" If="" SkipIf="">
          <Value Key="CallType" If="" SkipIf="" Passes="2" Type="String">[CallType]</Value>
          <Value Key="Number" If="" SkipIf="" Passes="2" Type="String">[Number]</Value>
          <Value Key="Duration" If="" SkipIf="" Passes="1" Type="String">[CallDuration]</Value>
          <Value Key="Agent" If="" SkipIf="" Passes="1" Type="String">[Agent]</Value>
          <Value Key="RecordUrl" If="" SkipIf="" Passes="1" Type="String">[RecordingUrl]</Value>
          <Value Key="ContactId" If="" SkipIf="" Passes="1" Type="String">[EntityId]</Value>
          <Value Key="CallDirection" If="" SkipIf="" Passes="1" Type="String">[CallDirection]</Value>
        </PostValues>
      </Request>
      <Variables />
      <Outputs AllowEmpty="false" />
    </Scenario>
  </Scenarios>
</Crm>
