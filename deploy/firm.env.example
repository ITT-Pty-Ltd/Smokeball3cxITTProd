# Per-firm secrets — copy to deploy/firms/<firm-id>.env (gitignored).
# Apply with: ./deploy/scripts/Apply-FirmSettings.ps1 -FirmId acme-law

SMOKEBALL_CLIENT_ID=
SMOKEBALL_CLIENT_SECRET=
SMOKEBALL_API_KEY=
SMOKEBALL_AUTH_URL=https://auth.smokeball.com.au
SMOKEBALL_API_URL=https://api.smokeball.com.au
SMOKEBALL_APP_URL=https://app.smokeball.com.au
SMOKEBALL_OAUTH_MODE=proxy
SMOKEBALL_REDIRECT_URI=https://smokeball3cx-acme.azurewebsites.net/auth/callback
PUBLIC_URL=https://smokeball3cx-acme.azurewebsites.net

JOURNAL_CREATE_TASKS=true
JOURNAL_REQUIRE_CONTACT=true
JOURNAL_REQUIRE_MATTER=false
JOURNAL_CREATE_TIME_ENTRIES=true
JOURNAL_SKIP_MISSED=false
SMOKEBALL_DEFAULT_STAFF_ID=
SMOKEBALL_TIME_ACTIVITY_CODE=

SMOKEBALL_MAX_RETRIES=3
SMOKEBALL_RETRY_BASE_DELAY_MS=500
SMOKEBALL_SEARCH_LIMIT=50
